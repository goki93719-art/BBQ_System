# Local development can omit these values and use edison-grill.local.db.
# Vercel deployments must connect a Turso database and define both Turso values.
# A single ECS Docker deployment can instead use:
# TURSO_DATABASE_URL=file:/app/data/edison-grill.db
# ECS without a domain can use SITE_ADDRESS=http://.
# After a domain resolves to the ECS public IP, use SITE_ADDRESS=bbq.example.com
# to enable automatic HTTPS and certificate renewal through Caddy.
TURSO_DATABASE_URL=libsql://your-database.turso.io
TURSO_AUTH_TOKEN=your-database-token
CRON_SECRET=replace-with-a-random-string-at-least-16-characters
SITE_ADDRESS=http://

# The current test build uses the fixed customer verification code 9999.
APP_ENV=demo
MOCK_SMS_ENABLED=true
