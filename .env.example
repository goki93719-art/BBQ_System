# Local development can omit these values and use edison-grill.local.db.
# Vercel deployments must connect a Turso database and define both values.
TURSO_DATABASE_URL=libsql://your-database.turso.io
TURSO_AUTH_TOKEN=your-database-token

# The current test build uses the fixed customer verification code 9999.
APP_ENV=demo
MOCK_SMS_ENABLED=true
